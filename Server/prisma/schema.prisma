generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum isRegistered{
  PENDING
  REJECTED
  ACCEPTED
}
model Kisaan {
  id            Int                 @id @default(autoincrement())
  name          String
  email         String?             @unique
  password      String
  address       String
  phone         String              @unique
  lat           Float?
  long          Float?
  refreshToken  String?
  organisations KisanOrganisation[]
  vyaparis      KisanVyapari[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted_At DateTime?
  tickets    RegistrationTaskTicket[]
  receipts   Receipt[]
}

model Vyapari {
  id            Int                   @id @default(autoincrement())
  name          String
  email         String                @unique
  password      String
  address       String
  phone         String                @unique
  lat           Float?
  long          Float?
  gstNumber     String?
  gsLoginId     String?               @unique
  gsPassword    String?
  refreshToken  String?
  kisans        KisanVyapari[]
  organisations OrganisationVyapari[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted_At DateTime?
  registrationStatus isRegistered @default(PENDING)
  tickets            RegistrationTaskTicket[]
  crops              Crops[]
}


model Organisation {
  id           Int                        @id @default(autoincrement())
  name         String
  email        String                     @unique
  password     String
  address      String
  phone        String                     @unique
  lat          Float?
  long         Float?
  gstNumber     String?
  gsLoginId     String?               @unique
  gsPassword    String?
  refreshToken String?
  kisans       KisanOrganisation[]
  buyers       OrganisationOrganisation[] @relation("OrgBuy")
  sellers      OrganisationOrganisation[] @relation("OrgSell")
  vyaparis     OrganisationVyapari[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted_At DateTime?
  registrationStatus isRegistered @default(PENDING)
  tickets    RegistrationTaskTicket[]
  crops      Crops[]
}

model Crops {
  id              Int           @id @default(autoincrement())
  cropName        String
  priceInPaise    Int
  quantityQuintal Float?
  traderId        Int?
  organisationId  Int?
  trader          Vyapari?      @relation(fields: [traderId], references: [id])
  organisation    Organisation? @relation(fields: [organisationId], references: [id])
  deletedAt       DateTime?
  receipts        Receipt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Receipt {
  id           Int      @id @default(autoincrement())
  cropId       Int
  crop         Crops    @relation(fields: [cropId], references: [id])
  cropPrice    Int
  farmerId     Int
  farmer       Kisaan   @relation(fields: [farmerId], references: [id])
  cropQuantity Float
  createdAt    DateTime @default(now())
}

model KisanVyapari {
  id        Int     @id @default(autoincrement())
  kisanId   Int
  vyapariId Int
  kisan     Kisaan  @relation(fields: [kisanId], references: [id])
  vyapari   Vyapari @relation(fields: [vyapariId], references: [id])

  @@unique([kisanId, vyapariId])
}

model KisanOrganisation {
  id             Int          @id @default(autoincrement())
  kisanId        Int
  organisationId Int
  kisan          Kisaan       @relation(fields: [kisanId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@unique([kisanId, organisationId])
}

model OrganisationVyapari {
  id             Int          @id @default(autoincrement())
  organisationId Int
  vyapariId      Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  vyapari        Vyapari      @relation(fields: [vyapariId], references: [id])

  @@unique([organisationId, vyapariId])
}

model OrganisationOrganisation {
  id       Int          @id @default(autoincrement())
  buyerId  Int
  sellerId Int
  buyer    Organisation @relation("OrgBuy", fields: [buyerId], references: [id])
  seller   Organisation @relation("OrgSell", fields: [sellerId], references: [id])

  @@unique([buyerId, sellerId])
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
  FAILED
}

model RegistrationTaskTicket {
  id          Int      @id @default(autoincrement())
  vyapariId   Int?     
  kisaanId    Int?
  orgId       Int?
  
  vyapari     Vyapari? @relation(fields: [vyapariId], references: [id])
  kisaan      Kisaan?  @relation(fields: [kisaanId], references: [id])
  org         Organisation? @relation(fields: [orgId], references: [id])
  
  status      TicketStatus @default(PENDING)
  
  employeeId  Int?     
  admin       Admin?       @relation(fields: [employeeId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  email       String   @unique
  password    String
  gsLoginId   String?  @unique
  refreshToken String?
  role        AdminRole @default(ADMIN)
  isActive    Boolean  @default(true)
  createdBy   Int?
  superAdmin  SuperAdmin? @relation(fields: [createdBy], references: [id])
  tickets     RegistrationTaskTicket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SuperAdmin {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  email       String   @unique
  password    String
  creds       String?
  refreshToken String?
  admins      Admin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContractStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SellContractStatus {
  ACTIVE
  COMPLETED
  DISPUTED
  CANCELLED
}

enum SenderRole {
  KISAAN
  VYAPARI
  ORGANISATION
}

enum ReceiverRole {
  VYAPARI
  ORGANISATION
}

model GsContract {
  id               Int            @id @default(autoincrement())
  cropName         String
  quantity         Float
  pricePerQuintal  Int
  totalAmount      Float
  senderId         Int
  senderRole       SenderRole
  receiverId       Int
  receiverRole     ReceiverRole
  status           ContractStatus @default(PENDING)
  expiresAt        DateTime
  message          String?
  sellContract     SellContract?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model SellContract {
  id               Int                @id @default(autoincrement())
  gsContractId     Int                @unique
  gsContract       GsContract         @relation(fields: [gsContractId], references: [id])
  cropName         String
  quantity         Float
  pricePerQuintal  Int
  totalAmount      Float
  sellerId         Int
  buyerId          Int
  status           SellContractStatus @default(ACTIVE)
  printedAt        DateTime?
  completedAt      DateTime?
  chatRooms        ChatRoom[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model ChatRoom {
  id               Int            @id @default(autoincrement())
  sellContractId   Int
  sellContract     SellContract   @relation(fields: [sellContractId], references: [id])
  messages         ChatMessage[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

model ChatMessage {
  id               Int            @id @default(autoincrement())
  roomId           Int
  room             ChatRoom       @relation(fields: [roomId], references: [id])
  senderId         Int
  content          String?
  type             MessageType    @default(TEXT)
  fileUrl          String?
  createdAt        DateTime       @default(now())
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  GST
  AADHAR
  PAN
  TRADE_LICENSE
}

model Document {
  id               Int            @id @default(autoincrement())
  userId           Int
  userRole         SenderRole
  fileUrl          String
  fileType         DocumentType
  status           DocumentStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Notification {
  id               Int            @id @default(autoincrement())
  userId           Int
  userRole         SenderRole
  type             String
  title            String
  body             String
  isRead           Boolean        @default(false)
  createdAt        DateTime       @default(now())
}
