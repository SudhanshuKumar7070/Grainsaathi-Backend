generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum isRegistered{
  PENDING
  REJECTED
  ACCEPTED
}
model Kisaan {
  id            Int                 @id @default(autoincrement())
  name          String
  email         String?             @unique
  password      String
  address       String
  phone         String              @unique
  lat           Float?
  long          Float?
  refreshToken  String?
  organisations KisanOrganisation[]
  vyaparis      KisanVyapari[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted_At DateTime?
  tickets    RegistrationTaskTicket[]
  receipts   Receipt[]
}

model Vyapari {
  id            Int                   @id @default(autoincrement())
  name          String
  email         String                @unique
  password      String
  address       String
  phone         String                @unique
  lat           Float?
  long          Float?
  gstNumber     String?
  refreshToken  String?
  kisans        KisanVyapari[]
  organisations OrganisationVyapari[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted_At DateTime?
  registrationStatus isRegistered @default(PENDING)
  tickets            RegistrationTaskTicket[]
  crops              Crops[]
}


model Organisation {
  id           Int                        @id @default(autoincrement())
  name         String
  email        String                     @unique
  password     String
  address      String
  phone        String                     @unique
  lat          Float?
  long         Float?
  gstNumber     String?
  refreshToken String?
  kisans       KisanOrganisation[]
  buyers       OrganisationOrganisation[] @relation("OrgBuy")
  sellers      OrganisationOrganisation[] @relation("OrgSell")
  vyaparis     OrganisationVyapari[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted_At DateTime?
  registrationStatus isRegistered @default(PENDING)
  tickets    RegistrationTaskTicket[]
  crops      Crops[]
}

model Crops {
  id              Int           @id @default(autoincrement())
  cropName        String
  priceInPaise    Int
  quantityQuintal Float?
  traderId        Int?
  organisationId  Int?
  trader          Vyapari?      @relation(fields: [traderId], references: [id])
  organisation    Organisation? @relation(fields: [organisationId], references: [id])
  deletedAt       DateTime?
  receipts        Receipt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Receipt {
  id           Int      @id @default(autoincrement())
  cropId       Int
  crop         Crops    @relation(fields: [cropId], references: [id])
  cropPrice    Int
  farmerId     Int
  farmer       Kisaan   @relation(fields: [farmerId], references: [id])
  cropQuantity Float
  createdAt    DateTime @default(now())
}

model KisanVyapari {
  id        Int     @id @default(autoincrement())
  kisanId   Int
  vyapariId Int
  kisan     Kisaan  @relation(fields: [kisanId], references: [id])
  vyapari   Vyapari @relation(fields: [vyapariId], references: [id])

  @@unique([kisanId, vyapariId])
}

model KisanOrganisation {
  id             Int          @id @default(autoincrement())
  kisanId        Int
  organisationId Int
  kisan          Kisaan       @relation(fields: [kisanId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@unique([kisanId, organisationId])
}

model OrganisationVyapari {
  id             Int          @id @default(autoincrement())
  organisationId Int
  vyapariId      Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  vyapari        Vyapari      @relation(fields: [vyapariId], references: [id])

  @@unique([organisationId, vyapariId])
}

model OrganisationOrganisation {
  id       Int          @id @default(autoincrement())
  buyerId  Int
  sellerId Int
  buyer    Organisation @relation("OrgBuy", fields: [buyerId], references: [id])
  seller   Organisation @relation("OrgSell", fields: [sellerId], references: [id])

  @@unique([buyerId, sellerId])
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
  FAILED
}

model RegistrationTaskTicket {
  id          Int      @id @default(autoincrement())
  vyapariId   Int?     
  kisaanId    Int?
  orgId       Int?
  
  vyapari     Vyapari? @relation(fields: [vyapariId], references: [id])
  kisaan      Kisaan?  @relation(fields: [kisaanId], references: [id])
  org         Organisation? @relation(fields: [orgId], references: [id])
  
  status      TicketStatus @default(PENDING)
  
  employeeId  Int?     
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
